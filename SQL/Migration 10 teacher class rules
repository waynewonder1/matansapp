-- ---------- curriculum ticks: only for your own class ----------
create or replace function public.matan_can_edit_class(cls text)
returns boolean language sql stable security definer set search_path = public as $$
  select public.matan_is_admin() or exists (select 1 from classes c where c.name = cls and c.teacher_id = auth.uid());
$$;
drop policy if exists cur_cov_add on curriculum_coverage;
create policy cur_cov_add on curriculum_coverage for insert to authenticated
  with check (public.matan_can_edit_class((select i.cls from curriculum_items i where i.id = item_id)));
drop policy if exists cur_cov_del on curriculum_coverage;
create policy cur_cov_del on curriculum_coverage for delete to authenticated
  using (public.matan_can_edit_class((select i.cls from curriculum_items i where i.id = item_id)));

notify pgrst, 'reload schema';
