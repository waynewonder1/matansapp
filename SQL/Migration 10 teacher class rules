drop policy if exists add_own_notes on teacher_notes;
create policy add_own_notes on teacher_notes for insert to authenticated
  with check (staff_id = auth.uid() and public.matan_can_edit_learner(learner_id));

drop policy if exists read_ai_insights on ai_insights;
