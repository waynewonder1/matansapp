-- Migration 10: a class teacher can only see and change the children in their own class.
-- The director and the senior teacher still see every class.
-- Before this, the app hid other classes on screen, but the database let any staff login read every child's records.
-- Run once in the Supabase SQL Editor. Safe to run again.
--
-- IMPORTANT: a teacher who is not assigned to a class (Staff page) will see no children after this.
-- Check every class teacher is assigned before running it.
--
-- "Their own class" uses the same rule the app already uses for changes: public.matan_can_edit_learner(learner_id),
-- which is true for the director, the senior teacher, and the teacher of that child's class (classes.teacher_id).

-- ---------- learners and guardians ----------
drop policy if exists read_learners on learners;
create policy read_learners on learners for select to authenticated
  using (public.matan_is_admin() or exists (select 1 from classes c where c.id = learners.class_id and c.teacher_id = auth.uid()));

drop policy if exists read_guardians on guardians;
create policy read_guardians on guardians for select to authenticated
  using (public.matan_can_edit_learner(learner_id));

-- ---------- term assessments ----------
drop policy if exists read_assessment_records on assessment_records;
create policy read_assessment_records on assessment_records for select to authenticated
  using (public.matan_can_edit_learner(learner_id));

drop policy if exists add_records on assessment_records;
create policy add_records on assessment_records for insert to authenticated
  with check (
    public.matan_can_edit_learner(learner_id)
    and rater_id = auth.uid()
    and rater_role = case public.staff_role() when 'head' then 'director' else 'teacher' end
    and (revision_of is null or exists (select 1 from assessment_records o where o.id = assessment_records.revision_of and o.rater_id = auth.uid())));

drop policy if exists read_reviews on score_reviews;
create policy read_reviews on score_reviews for select to authenticated
  using (public.matan_can_edit_learner(learner_id));

-- The score views read the tables above with the viewer's own rights, so they follow the same rules.
alter view public.area_scores set (security_invoker = true);
alter view public.rater_agreement set (security_invoker = true);

-- ---------- attendance (children) ----------
drop policy if exists read_attendance on attendance;
create policy read_attendance on attendance for select to authenticated
  using (public.matan_can_edit_learner(learner_id));

drop policy if exists staff_writes_attendance on attendance;
create policy staff_writes_attendance on attendance for all to authenticated
  using (public.matan_can_edit_learner(learner_id))
  with check (public.matan_can_edit_learner(learner_id));

