-- Migration 11: links from the app to the curriculum design PDFs, opening at the right page.
-- Run once in the Supabase SQL Editor. Safe to run again.
--
-- 1. A PRIVATE storage bucket called "curriculum". Only signed-in Matan staff can open the files in it.
--    After running this file, upload the three PDFs into it (Storage > curriculum > Upload file), named exactly:
--      PG.pdf   PP1.pdf   PP2.pdf
-- 2. A page number for each sub-strand, so "Open in the curriculum design" goes straight to it.
--    The page numbers were read from the PDFs on 2026-11-24. If a PDF is replaced with a new edition,
--    the page numbers need working out again.

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('curriculum', 'curriculum', false, 20971520, array['application/pdf'])
on conflict (id) do update set public = false;

-- Signed-in staff can read the PDFs. Nobody else can, and the bucket is not public.
-- (Uploading is done by the director in the Supabase dashboard, which does not need a rule.)
drop policy if exists matan_staff_read_curriculum on storage.objects;
create policy matan_staff_read_curriculum on storage.objects for select to authenticated
  using (bucket_id = 'curriculum' and (select public.matan_is_staff()));

alter table curriculum_items add column if not exists pdf_page integer;

update curriculum_items i set pdf_page = v.p
