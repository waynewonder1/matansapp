-- migration-4-support-plans.sql
-- Support plans, needs, accommodations, goals and consent for learners with disabilities.
-- Run once in the Supabase SQL Editor, AFTER the earlier migrations. Safe to run again.
--
-- It assumes these tables and columns already exist, because app.js uses them:
--   staff(id uuid = auth user, name, role 'head' | 'teacher')
--   classes(id, name, teacher_id)        learners(id uuid, class_id, active)
--   terms(id)                            follow_up_actions(...)    assessment_records(...)
-- If learners.id is not a uuid, change "uuid" to its type in the learner_id columns below.

-- ---------- helper functions (used by the policies) ----------
create or replace function public.matan_is_staff() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from staff s where s.id = auth.uid());
$$;

create or replace function public.matan_is_head() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from staff s where s.id = auth.uid() and s.role = 'head');
$$;

-- The director, or the class teacher of this learner's class.
create or replace function public.matan_can_edit_learner(lid uuid) returns boolean
language sql stable security definer set search_path = public as $$
  select public.matan_is_head() or exists (
    select 1 from learners l join classes c on c.id = l.class_id
    where l.id = lid and c.teacher_id = auth.uid());
$$;

create or replace function public.matan_goal_learner(gid uuid) returns uuid
language sql stable security definer set search_path = public as $$
  select learner_id from learner_goals where id = gid;
$$;

-- ---------- consent ----------
create table if not exists learner_consents (
  id uuid primary key default gen_random_uuid(),
  learner_id uuid not null references learners(id) on delete cascade,
  kind text not null check (kind in ('support_needs','gemini','whatsapp','media')),
  granted_by text,                       -- guardian's name as written on the signed form
  granted_on date not null default current_date,
  withdrawn_on date,
  recorded_by uuid references staff(id),
  created_at timestamptz not null default now()
);

-- ---------- support plan (one row per learner) ----------
create table if not exists learner_support_profiles (
  learner_id uuid primary key references learners(id) on delete cascade,
  pathway text not null default 'regular_adapted'
    check (pathway in ('regular','regular_adapted','specialised_foundation','specialised_intermediate')),
  communication_notes text,
  what_works text,
  what_to_avoid text,
  next_review date,
  created_by uuid references staff(id),
  created_at timestamptz not null default now(),
  updated_by uuid references staff(id),
  updated_at timestamptz not null default now()
);

-- Health and safety note, kept apart so only the director and class teacher can read it.
create table if not exists learner_health_notes (
  learner_id uuid primary key references learners(id) on delete cascade,
  note text,
  updated_by uuid references staff(id),
  updated_at timestamptz not null default now()
);

create table if not exists learner_needs (
  id uuid primary key default gen_random_uuid(),
  learner_id uuid not null references learners(id) on delete cascade,
  need_type text not null
    check (need_type in ('visual','hearing','physical','intellectual','speech_language','other')),
  detail text,
  source text,                           -- for example "assessment centre report, March 2026"
  recorded_on date not null default current_date,
  active boolean not null default true,
  created_by uuid references staff(id),
  created_at timestamptz not null default now()
);

create table if not exists learner_accommodations (
  id uuid primary key default gen_random_uuid(),
  learner_id uuid not null references learners(id) on delete cascade,
  accommodation text not null,
  applies_to text not null default 'both' check (applies_to in ('assessment','classroom','both')),
  active boolean not null default true,
  created_by uuid references staff(id),
  created_at timestamptz not null default now(),
  unique (learner_id, accommodation)
);

-- ---------- goals ----------
create table if not exists learner_goals (
  id uuid primary key default gen_random_uuid(),
  learner_id uuid not null references learners(id) on delete cascade,
  domain text not null,
  goal text not null,
  baseline text,
  target text,
  target_date date,
  status text not null default 'active' check (status in ('active','achieved','paused','dropped')),
  achieved_on date,
  term_id bigint references terms(id),
  created_by uuid references staff(id),
  created_at timestamptz not null default now()
);

-- Check-ins are only ever added, never changed, like assessment_records.
create table if not exists goal_progress (
  id uuid primary key default gen_random_uuid(),
  goal_id uuid not null references learner_goals(id) on delete cascade,
  level int not null check (level between 0 and 5),
  note text,
  rater_id uuid references staff(id),
  entered_at timestamptz not null default now()
);

create index if not exists learner_needs_learner on learner_needs(learner_id);
create index if not exists learner_accommodations_learner on learner_accommodations(learner_id);
create index if not exists learner_goals_learner on learner_goals(learner_id);
create index if not exists goal_progress_goal on goal_progress(goal_id, entered_at);
create index if not exists learner_consents_learner on learner_consents(learner_id);

-- ---------- two new columns on existing tables ----------
alter table follow_up_actions add column if not exists goal_id uuid references learner_goals(id) on delete set null;
alter table assessment_records add column if not exists adapted boolean not null default false;

-- ---------- row level security ----------
alter table learner_consents enable row level security;
alter table learner_support_profiles enable row level security;
alter table learner_health_notes enable row level security;
alter table learner_needs enable row level security;
alter table learner_accommodations enable row level security;
alter table learner_goals enable row level security;
alter table goal_progress enable row level security;

-- Consent: all staff can see it; the director or class teacher records it; only the director can withdraw it.
drop policy if exists consents_read on learner_consents;
create policy consents_read on learner_consents for select to authenticated using (public.matan_is_staff());
drop policy if exists consents_add on learner_consents;
create policy consents_add on learner_consents for insert to authenticated
  with check (public.matan_can_edit_learner(learner_id) and recorded_by = auth.uid());
drop policy if exists consents_withdraw on learner_consents;
create policy consents_withdraw on learner_consents for update to authenticated
  using (public.matan_is_head()) with check (public.matan_is_head());

-- Support plan: all staff read; director or class teacher writes. A plan can only be created
-- once a signed "support_needs" consent that has not been withdrawn is on file.
drop policy if exists profiles_read on learner_support_profiles;
create policy profiles_read on learner_support_profiles for select to authenticated using (public.matan_is_staff());
drop policy if exists profiles_add on learner_support_profiles;
create policy profiles_add on learner_support_profiles for insert to authenticated
  with check (
    public.matan_can_edit_learner(learner_id)
    and exists (select 1 from learner_consents c
                where c.learner_id = learner_support_profiles.learner_id
                  and c.kind = 'support_needs' and c.withdrawn_on is null));
drop policy if exists profiles_change on learner_support_profiles;
create policy profiles_change on learner_support_profiles for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));
drop policy if exists profiles_remove on learner_support_profiles;
create policy profiles_remove on learner_support_profiles for delete to authenticated using (public.matan_is_head());

-- Health note: only the director and the class teacher.
drop policy if exists health_read on learner_health_notes;
create policy health_read on learner_health_notes for select to authenticated using (public.matan_can_edit_learner(learner_id));
drop policy if exists health_add on learner_health_notes;
create policy health_add on learner_health_notes for insert to authenticated with check (public.matan_can_edit_learner(learner_id));
drop policy if exists health_change on learner_health_notes;
create policy health_change on learner_health_notes for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));

-- Needs and accommodations: all staff read; director or class teacher writes; only the director deletes
-- (everyone else switches an item off with active = false).
drop policy if exists needs_read on learner_needs;
create policy needs_read on learner_needs for select to authenticated using (public.matan_is_staff());
drop policy if exists needs_add on learner_needs;
create policy needs_add on learner_needs for insert to authenticated with check (public.matan_can_edit_learner(learner_id));
drop policy if exists needs_change on learner_needs;
create policy needs_change on learner_needs for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));
drop policy if exists needs_remove on learner_needs;
create policy needs_remove on learner_needs for delete to authenticated using (public.matan_is_head());

drop policy if exists accom_read on learner_accommodations;
create policy accom_read on learner_accommodations for select to authenticated using (public.matan_is_staff());
drop policy if exists accom_add on learner_accommodations;
create policy accom_add on learner_accommodations for insert to authenticated with check (public.matan_can_edit_learner(learner_id));
drop policy if exists accom_change on learner_accommodations;
create policy accom_change on learner_accommodations for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));
drop policy if exists accom_remove on learner_accommodations;
create policy accom_remove on learner_accommodations for delete to authenticated using (public.matan_is_head());

-- Goals: all staff read; director or class teacher writes.
drop policy if exists goals_read on learner_goals;
create policy goals_read on learner_goals for select to authenticated using (public.matan_is_staff());
drop policy if exists goals_add on learner_goals;
create policy goals_add on learner_goals for insert to authenticated
  with check (public.matan_can_edit_learner(learner_id) and created_by = auth.uid());
drop policy if exists goals_change on learner_goals;
create policy goals_change on learner_goals for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));

-- Check-ins: all staff read; director or class teacher adds; nobody edits or deletes.
drop policy if exists progress_read on goal_progress;
create policy progress_read on goal_progress for select to authenticated using (public.matan_is_staff());
drop policy if exists progress_add on goal_progress;
create policy progress_add on goal_progress for insert to authenticated
  with check (public.matan_can_edit_learner(public.matan_goal_learner(goal_id)) and rater_id = auth.uid());