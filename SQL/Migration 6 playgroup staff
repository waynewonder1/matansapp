-- migration-6-playgroup-staff.sql
-- Stage 1: Playgroup class, senior teacher role, staff dashboard, teacher attendance, attendance reasons.
-- Run once in the Supabase SQL Editor, AFTER migration-4 and migration-5. Safe to run again.
-- Assumes: classes(id, name, teacher_id), learning_areas(id, name), competencies(code, class_id, area_id, strand,
-- sub_strand, description, curriculum_ref, source, created_by), attendance(learner_id, day, present).

-- ---------- helper functions ----------
create or replace function public.matan_is_senior() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from staff s where s.id = auth.uid() and s.role = 'senior');
$$;
-- Director or senior teacher.
create or replace function public.matan_is_admin() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from staff s where s.id = auth.uid() and s.role in ('head','senior'));
$$;
-- The senior teacher can work in every class, like the director (but has no Teaching insights screen in the app).
create or replace function public.matan_can_edit_learner(lid uuid) returns boolean
language sql stable security definer set search_path = public as $$
  select public.matan_is_admin() or exists (
    select 1 from learners l join classes c on c.id = l.class_id
    where l.id = lid and c.teacher_id = auth.uid());
$$;

-- ---------- staff roles ----------
alter table staff drop constraint if exists staff_role_check;
alter table staff add constraint staff_role_check check (role in ('head','senior','teacher'));
alter table staff add column if not exists phone text;
alter table staff add column if not exists active boolean not null default true;

-- Only the director changes staff and class teachers. (These add to your existing read policies; they do not switch row level security on.)
drop policy if exists staff_head_write on staff;
create policy staff_head_write on staff for all to authenticated
  using (public.matan_is_head()) with check (public.matan_is_head());
drop policy if exists classes_head_write on classes;
create policy classes_head_write on classes for all to authenticated
  using (public.matan_is_head()) with check (public.matan_is_head());

