insert into competencies (code, class_id, area_id, strand, sub_strand, description, curriculum_ref, source)
select s.code, (select id from classes where name = 'PG'), (select id from learning_areas where name = s.area),
       s.strand, s.sub, 'Term ' || s.term || ': ' || s.sub, 'Matan PG 2027 ' || substring(s.code from 4), 'curriculum'
from src s
where not exists (select 1 from competencies c where c.code = s.code);

-- ---------- learner attendance: reasons and late arrivals ----------
alter table attendance add column if not exists late boolean not null default false;
alter table attendance add column if not exists reason text;

-- ---------- teacher attendance ----------
create table if not exists staff_attendance (
  id uuid primary key default gen_random_uuid(),
  staff_id uuid not null references staff(id) on delete cascade,
  day date not null,
  status text not null check (status in ('present','late','absent','leave')),
  time_in text,
  note text,
  marked_by uuid references staff(id),
  created_at timestamptz not null default now(),
  unique (staff_id, day)
);
alter table staff_attendance enable row level security;
-- Director and senior teacher see and mark everyone. A teacher sees only their own days.
drop policy if exists sa_read on staff_attendance;
create policy sa_read on staff_attendance for select to authenticated
  using (public.matan_is_admin() or staff_id = auth.uid());
drop policy if exists sa_write on staff_attendance;
create policy sa_write on staff_attendance for all to authenticated
  using (public.matan_is_admin()) with check (public.matan_is_admin());

-- ---------- the senior teacher can work in every class ----------
-- These add to the existing policies (policies are combined with "or"). They are skipped for tables that do not exist.
do $$
declare t text;
begin
  foreach t in array array['learners','guardians','attendance','question_variants','competencies','teacher_notes','follow_up_actions','parent_messages'] loop
    if to_regclass('public.' || t) is not null then
      execute format('drop policy if exists admin_all_%I on %I', t, t);
      execute format('create policy admin_all_%I on %I for all to authenticated using (public.matan_is_admin()) with check (public.matan_is_admin())', t, t);
    end if;
  end loop;
end $$;
-- Assessment scores: the senior teacher scores as a teacher, under their own login.
drop policy if exists admin_score_assessment on assessment_records;
create policy admin_score_assessment on assessment_records for insert to authenticated
  with check (public.matan_is_senior() and rater_id = auth.uid() and rater_role = 'teacher');