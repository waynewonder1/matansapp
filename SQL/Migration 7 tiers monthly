-- migration-7-tiers-monthly.sql
-- Stage 2: support tiers A, B and C, the doctor's report, and monthly AI tests and goals.
-- Run once in the Supabase SQL Editor, AFTER migration-4, 5 and 6. Safe to run again.

-- ---------- tier (one row per learner) ----------
-- A = no disability, B = some disability (usual curriculum with adaptations), C = severe disability (specialised curriculum).
create table if not exists learner_tiers (
  learner_id uuid primary key references learners(id) on delete cascade,
  declared text not null default 'none' check (declared in ('none','some','severe')),   -- what the admission form says
  suggested_tier text check (suggested_tier in ('A','B','C')),
  suggestion_reason text,
  suggested_at timestamptz,
  confirmed_tier text check (confirmed_tier in ('A','B','C')),
  confirmed_by uuid references staff(id),
  confirmed_at timestamptz,
  updated_at timestamptz not null default now()
);

-- The doctor's report is kept apart, so only the director, the senior teacher and the class teacher can read it.
create table if not exists learner_reports (
  learner_id uuid primary key references learners(id) on delete cascade,
  report text,
  updated_by uuid references staff(id),
  updated_at timestamptz not null default now()
);

alter table learner_tiers enable row level security;
alter table learner_reports enable row level security;

drop policy if exists tiers_read on learner_tiers;
create policy tiers_read on learner_tiers for select to authenticated using (public.matan_is_staff());
drop policy if exists tiers_add on learner_tiers;
create policy tiers_add on learner_tiers for insert to authenticated with check (public.matan_can_edit_learner(learner_id));
drop policy if exists tiers_change on learner_tiers;
create policy tiers_change on learner_tiers for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));

drop policy if exists reports_read on learner_reports;
create policy reports_read on learner_reports for select to authenticated using (public.matan_can_edit_learner(learner_id));
drop policy if exists reports_add on learner_reports;
create policy reports_add on learner_reports for insert to authenticated with check (public.matan_can_edit_learner(learner_id));
drop policy if exists reports_change on learner_reports;
create policy reports_change on learner_reports for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));

-- Only the director or a senior teacher can confirm or change the confirmed tier.
create or replace function public.matan_guard_tier() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  if (tg_op = 'INSERT' and new.confirmed_tier is not null and not public.matan_is_admin())
     or (tg_op = 'UPDATE' and new.confirmed_tier is distinct from old.confirmed_tier and not public.matan_is_admin()) then
    raise exception 'Only the director or a senior teacher can confirm a tier.';
  end if;
  new.updated_at := now();
  return new;
end $$;
drop trigger if exists learner_tiers_guard on learner_tiers;
create trigger learner_tiers_guard before insert or update on learner_tiers
  for each row execute function public.matan_guard_tier();

-- ---------- monthly tests and goals ----------
alter table learner_questions add column if not exists month date;        -- first day of the month the question is for
alter table learner_questions add column if not exists sub_strand text;   -- the curriculum sub-strand it checks
alter table learner_goals add column if not exists month date;
create index if not exists learner_questions_month on learner_questions(learner_id, month);