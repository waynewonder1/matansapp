-- migration-8-checks-curriculum-reports.sql
-- Stage 3: curriculum tick-off, small checks (kept apart from end-of-term exams), AI insights after checks, and termly report cards.
-- Run once in the Supabase SQL Editor, AFTER migration-4, 5, 6 and 7. Safe to run again.
--
-- How the pieces fit together:
--   * assessment_records stays as it is. It is the END-OF-TERM EXAM, and it is the only thing that feeds the graph, the trend and the report card.
--   * check_records is new. Small checks go here, so they never move the graph.
--   * assessment_notes holds the short insight written after a small check (the teacher approves it before it is saved).
--   * curriculum_items holds every sub-strand of the KICD designs; curriculum_coverage records which ones have been taught.
--   * report_comments holds the teacher's and the director's words on each learner's termly report card.

-- ---------- curriculum ----------
create table if not exists curriculum_items (
  id uuid primary key default gen_random_uuid(),
  cls text not null check (cls in ('PG','PP1','PP2')),
  area smallint not null check (area between 0 and 4),   -- same 0..4 order the app uses for the class
  code text not null,
  strand text,
  name text not null,
  lessons integer,
  term smallint,                                          -- planned term (Playgroup design only)
  sort integer not null default 0,
  unique (cls, area, code)
);
create table if not exists curriculum_coverage (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references curriculum_items(id) on delete cascade,
  term_id bigint,                                         -- the term in which it was taught
  taught_on date not null default current_date,
  taught_by uuid references staff(id),
  note text,
  created_at timestamptz not null default now(),
  unique (item_id)
);

-- ---------- small checks ----------
create table if not exists check_records (
  id uuid primary key default gen_random_uuid(),
  batch_id uuid not null,                                 -- one small check = one batch
  learner_id uuid not null references learners(id) on delete cascade,
  term_id bigint,
  area smallint not null check (area between 0 and 4),
  competency_id text,                                     -- kept as text so it works whatever type competencies.id has
  variant_id text,
  rater_id uuid references staff(id),
  rater_role text,
  score text not null,
  support_code text,
  comment text,
  entered_at timestamptz not null default now()
);
create index if not exists check_records_learner on check_records(learner_id, entered_at);

create table if not exists assessment_notes (
  id uuid primary key default gen_random_uuid(),
  learner_id uuid not null references learners(id) on delete cascade,
  kind text not null default 'check' check (kind in ('check')),
  batch_id uuid,
  term_id bigint,
  area smallint,
  avg_score numeric,
  body text not null,
  source text not null default 'rules' check (source in ('ai','rules','teacher')),
  created_by uuid references staff(id),
  created_at timestamptz not null default now()
);
create index if not exists assessment_notes_learner on assessment_notes(learner_id, created_at);

-- ---------- report card comments ----------
create table if not exists report_comments (
  learner_id uuid not null references learners(id) on delete cascade,
  term_id bigint not null,
  teacher_comment text,
  head_comment text,
  teacher_by uuid references staff(id),
  head_by uuid references staff(id),
  updated_at timestamptz not null default now(),
  primary key (learner_id, term_id)
);

-- ---------- security ----------
alter table curriculum_items enable row level security;
alter table curriculum_coverage enable row level security;
alter table check_records enable row level security;
alter table assessment_notes enable row level security;
alter table report_comments enable row level security;

drop policy if exists cur_items_read on curriculum_items;
create policy cur_items_read on curriculum_items for select to authenticated using (public.matan_is_staff());
drop policy if exists cur_items_write on curriculum_items;
create policy cur_items_write on curriculum_items for all to authenticated using (public.matan_is_admin()) with check (public.matan_is_admin());

drop policy if exists cur_cov_read on curriculum_coverage;
create policy cur_cov_read on curriculum_coverage for select to authenticated using (public.matan_is_staff());
drop policy if exists cur_cov_add on curriculum_coverage;
create policy cur_cov_add on curriculum_coverage for insert to authenticated with check (public.matan_is_staff());
drop policy if exists cur_cov_del on curriculum_coverage;
create policy cur_cov_del on curriculum_coverage for delete to authenticated using (public.matan_is_staff());

drop policy if exists checks_read on check_records;
create policy checks_read on check_records for select to authenticated using (public.matan_is_staff());
drop policy if exists checks_add on check_records;
create policy checks_add on check_records for insert to authenticated
  with check (public.matan_can_edit_learner(learner_id) and rater_id = auth.uid());
-- no update or delete policy: small checks, like exams, are never edited after saving.

drop policy if exists notes_read on assessment_notes;
create policy notes_read on assessment_notes for select to authenticated using (public.matan_is_staff());
drop policy if exists notes_add on assessment_notes;
create policy notes_add on assessment_notes for insert to authenticated
  with check (public.matan_can_edit_learner(learner_id) and created_by = auth.uid());

drop policy if exists rc_read on report_comments;
create policy rc_read on report_comments for select to authenticated using (public.matan_is_staff());
drop policy if exists rc_add on report_comments;
create policy rc_add on report_comments for insert to authenticated with check (public.matan_can_edit_learner(learner_id));
drop policy if exists rc_change on report_comments;
create policy rc_change on report_comments for update to authenticated
  using (public.matan_can_edit_learner(learner_id)) with check (public.matan_can_edit_learner(learner_id));

-- The director's comment can only be written by the director.
create or replace function public.matan_guard_report_comment() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  if (tg_op = 'INSERT' and new.head_comment is not null and not public.matan_is_head())
     or (tg_op = 'UPDATE' and new.head_comment is distinct from old.head_comment and not public.matan_is_head()) then
    raise exception 'Only the director can write the director''s comment.';
  end if;
  new.updated_at := now();
  return new;
end $$;
drop trigger if exists report_comments_guard on report_comments;
create trigger report_comments_guard before insert or update on report_comments
  for each row execute function public.matan_guard_report_comment();

